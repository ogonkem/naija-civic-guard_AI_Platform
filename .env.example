# Copy to .env and fill in. .env is gitignored - never commit real secrets.

# --- Django ---
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
# Comma-separated hostnames for production, e.g. example.com,www.example.com
DJANGO_ALLOWED_HOSTS=

# --- LLM (required) ---
# Must be a model your Groq key can access:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
GROQ_API_KEY=
GROQ_LLM_MODEL=openai/gpt-oss-20b
# Cheap/fast model for the LangGraph classify node only (never generation):
CLASSIFY_LLM_MODEL=allam-2-7b

# --- Observability (optional) ---
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="Naija-Civic-Guard"

# --- Async evaluation: Celery broker + result backend (Redis) ---
# Used only by the async RAG evaluation pipeline; the request path never waits
# on it. If Redis / the worker is down, requests are unaffected - eval rows
# just don't get written.
REDIS_URL=redis://localhost:6379/0
# Optional per-role overrides (default to REDIS_URL):
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Run eval inline instead of via a worker (dev only, no Redis needed):
# CELERY_TASK_ALWAYS_EAGER=1

# --- Only if you switch the LLM to local Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
