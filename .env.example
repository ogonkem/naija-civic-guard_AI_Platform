# Copy to .env and fill in. .env is gitignored - never commit real secrets.
#
# docker-compose.yml reads EVERYTHING from here - there are no inline defaults.
# A missing required var aborts `docker compose up` with a message.
#
# The values below are set for the docker-compose network. For a bare
# (non-Docker) `python manage.py runserver`, change the four marked
# "compose-network" lines: blank POSTGRES_HOST (-> SQLite), blank CHROMA_HOST
# (-> local dir), blank MCP_SERVER_URL (-> stdio subprocess), and point
# REDIS_URL / OLLAMA_BASE_URL at localhost.

# ===================== Docker images (pinned) =====================
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
CHROMA_IMAGE=chromadb/chroma:1.0.15
PROMETHEUS_IMAGE=prom/prometheus:v2.54.1
GRAFANA_IMAGE=grafana/grafana:11.2.0

# ===================== Django =====================
# Generate: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,gateway

# ===================== Generation LLM =====================
# openai = any OpenAI-compatible hosted API (default target: Groq) | ollama = host Ollama
LLM_PROVIDER=openai
GROQ_API_KEY=
GROQ_LLM_MODEL=openai/gpt-oss-20b
# Point at real OpenAI instead of Groq:
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_LLM_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_LLM_MODEL=llama3.2
# Cheap/fast model for the LangGraph classify node only (never generation):
CLASSIFY_LLM_MODEL=allam-2-7b

# ===================== Gateway =====================
API_KEY_DEFAULT_RATE=60/min
# Pin the key the bundled browser chat page uses (else auto-provisioned):
BROWSER_API_KEY=
# Ingest the constitution into ChromaDB on first boot if the collection is empty:
AUTO_INGEST=1
GATEWAY_HOST_PORT=8000

# ===================== Postgres (audit + metrics + eval_results) =====================
POSTGRES_DB=civicguard
POSTGRES_USER=civicguard
POSTGRES_PASSWORD=civicguard
POSTGRES_HOST=postgres          # compose-network (blank -> SQLite for a bare run)
POSTGRES_PORT=5432

# ===================== Redis + Celery (async eval) =====================
REDIS_URL=redis://redis:6379/0  # compose-network (redis://localhost:6379/0 for a bare run)
REDIS_HOST_PORT=6380            # host port docker-compose publishes Redis on
CELERY_QUEUE=eval
CELERY_LOGLEVEL=info
CELERY_POOL=threads             # threads keeps the prometheus_client registry shared
CELERY_CONCURRENCY=4
# CELERY_TASK_ALWAYS_EAGER=1    # run eval inline, no worker (dev only)

# ===================== ChromaDB (vector store) =====================
CHROMA_HOST=chromadb            # compose-network (blank -> local CHROMA_DB_PATH for a bare run)
CHROMA_PORT=8000
CHROMA_HOST_PORT=8001           # host port docker-compose publishes ChromaDB on
CHROMA_IS_PERSISTENT=TRUE
CHROMA_ANONYMIZED_TELEMETRY=FALSE
CHROMA_DB_PATH=chroma_db        # only used when CHROMA_HOST is blank

# ===================== MCP tool server (Phase 5) =====================
MCP_SERVER_URL=http://mcp:8100/mcp   # compose-network (blank -> gateway spawns it over stdio)
MCP_TRANSPORT=streamable-http
MCP_BIND_HOST=0.0.0.0                # what the mcp container binds to
MCP_PORT=8100
MCP_HOST_PORT=8100                   # host port docker-compose publishes the mcp server on
MCP_LOG_LEVEL=WARNING

# ===================== Worker metrics (Prometheus scrape target) =====================
WORKER_METRICS_PORT=9540
WORKER_METRICS_HOST_PORT=9540

# ===================== Prometheus + Grafana =====================
PROMETHEUS_HOST_PORT=9090
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ANONYMOUS_ENABLED=true
GRAFANA_ANONYMOUS_ROLE=Admin
GRAFANA_DEFAULT_THEME=light
GRAFANA_HOST_PORT=3000

# ===================== Healthchecks (postgres, redis) =====================
HEALTHCHECK_INTERVAL=5s
HEALTHCHECK_TIMEOUT=3s
HEALTHCHECK_RETRIES=20

# ===================== Observability (optional) =====================
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Naija-Civic-Guard
