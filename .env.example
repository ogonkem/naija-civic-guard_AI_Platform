# Copy to .env and fill in. .env is gitignored - never commit real secrets.
# Values marked "compose-set" are injected by docker-compose.yml for the
# container network; you only need them here for a bare (non-Docker) run.

# ── Django ────────────────────────────────────────────────────────────────
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
# Comma-separated hostnames. Compose sets "localhost,127.0.0.1,gateway".
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── LLM (required) ────────────────────────────────────────────────────────
# Generation provider: "openai" (any OpenAI-compatible hosted API - default
# target is Groq) or "ollama" (host Ollama). Prometheus splits latency /
# throughput on this label.
LLM_PROVIDER=openai

# openai path (default -> Groq's OpenAI-compatible endpoint with GROQ_API_KEY):
GROQ_API_KEY=
GROQ_LLM_MODEL=openai/gpt-oss-20b
# OPENAI_BASE_URL=https://api.openai.com/v1   # point at real OpenAI instead
# OPENAI_API_KEY=
# OPENAI_LLM_MODEL=gpt-4o-mini

# ollama path (runs OUTSIDE Docker; containers reach it via host.docker.internal):
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2

# Cheap/fast model for the LangGraph classify node only (never generation):
CLASSIFY_LLM_MODEL=allam-2-7b

# ── Gateway ──────────────────────────────────────────────────────────────
# Default rate limit for API keys without their own requests_per_minute:
API_KEY_DEFAULT_RATE=60/min
# Pin the key the bundled browser chat page uses (else one is auto-provisioned):
BROWSER_API_KEY=
# Ingest the constitution into ChromaDB on first boot if the collection is empty:
AUTO_INGEST=1

# ── Postgres (audit + metrics + eval_results) ────────────────────────────
# If POSTGRES_HOST is unset the app uses local SQLite. Compose sets HOST=postgres.
POSTGRES_DB=civicguard
POSTGRES_USER=civicguard
POSTGRES_PASSWORD=civicguard
POSTGRES_HOST=
POSTGRES_PORT=5432
# Host port docker-compose publishes Postgres on (for psql from your machine):
POSTGRES_HOST_PORT=55432

# ── Redis + Celery (async evaluation) ───────────────────────────────────
# Compose sets REDIS_URL=redis://redis:6379/0.
REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL / CELERY_RESULT_BACKEND default to REDIS_URL.
# CELERY_TASK_ALWAYS_EAGER=1   # run eval inline, no worker (dev only)
REDIS_HOST_PORT=6380

# ── ChromaDB (vector store) ─────────────────────────────────────────────
# Unset -> local persistent dir at CHROMA_DB_PATH. Compose sets HOST=chromadb.
CHROMA_HOST=
CHROMA_PORT=8000
CHROMA_DB_PATH=chroma_db
CHROMA_HOST_PORT=8001

# ── MCP tool server (Phase 5) ──────────────────────────────────────────
# Unset -> gateway spawns it over stdio. Compose sets the URL to the mcp service.
MCP_SERVER_URL=
MCP_HOST_PORT=8100

# ── Observability (Prometheus + Grafana) ─────────────────────────────
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="Naija-Civic-Guard"
GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000
GATEWAY_HOST_PORT=8000
# Celery worker exposes its own Prometheus registry (queue depth, eval task
# duration/failures, eval coverage) on this port; Prometheus scrapes it too.
WORKER_METRICS_PORT=9540
WORKER_METRICS_HOST_PORT=9540
